# ------------------------------------------------------------------
# Walk with God - environment template
# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env` or paste real secrets into chat/issues.
# ------------------------------------------------------------------

# --- Application ---
APP_NAME="Walk with God API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG="false"

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:5173"

# ------------------------------------------------------------------
# Added in later stages. Leave commented until those features exist.
# ------------------------------------------------------------------

# --- Database (Stage 3) ---
# Supabase Postgres connection string using the async driver.
# Prefer the direct connection or session pooler for Alembic migrations.
# DATABASE_URL="postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Stage 4) ---
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
# SUPABASE_JWT_ISSUER="https://YOUR_PROJECT_REF.supabase.co/auth/v1"
# SUPABASE_JWT_AUDIENCE="authenticated"

# --- AI provider (Stage 7) ---
# AI_PROVIDER="gemini"          # or "mock" for local tests
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# --- Web Push (Stage 8) ---
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
