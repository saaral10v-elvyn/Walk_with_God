# ------------------------------------------------------------------
# Walk with God - environment template
# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env` or paste real secrets into chat/issues.
# ------------------------------------------------------------------

# --- Application ---
APP_NAME="Walk with God API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG="false"

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:5173"

# ------------------------------------------------------------------
# Added in later stages. Leave commented until those features exist.
# ------------------------------------------------------------------

# --- Database (Stage 3) ---
# Paste the Session pooler string from Supabase, then change the scheme to
# postgresql+asyncpg:// (plain postgresql:// is also accepted).
# Percent-encode reserved characters in the password (for example @ -> %40).
# DATABASE_URL="postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# TLS: "require" encrypts the connection (Supabase's documented default).
# "verify-full" also verifies the server identity; set DB_SSL_CA_FILE to the
# root certificate downloaded from Supabase > Database settings.
# DB_SSL_MODE="require"
# DB_SSL_CA_FILE="C:/path/to/supabase-root-ca.crt"

# DB_ECHO="false"
# DB_POOL_SIZE="5"
# DB_MAX_OVERFLOW="5"

# --- Supabase Auth (Stage 4) ---
# The backend verifies Supabase access tokens against the project's JWKS.
# The JWKS URL and issuer are derived from SUPABASE_URL when omitted.
# The project must use an asymmetric signing key (ECC P-256 / ES256), not the
# legacy shared HS256 secret.
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
# SUPABASE_JWT_ISSUER="https://YOUR_PROJECT_REF.supabase.co/auth/v1"
# SUPABASE_JWT_AUDIENCE="authenticated"
# SUPABASE_JWT_LEEWAY_SECONDS="30"
# SUPABASE_JWKS_CACHE_SECONDS="3600"

# --- AI provider (Stage 7) ---
# AI_PROVIDER="gemini"          # or "mock" for local tests
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# --- Web Push (Stage 8) ---
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
