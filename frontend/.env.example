# ------------------------------------------------------------------
# Walk with God - frontend environment template
# Copy to `.env` for local overrides. Only VITE_* values are exposed
# to the browser, so NEVER put secrets here.
# ------------------------------------------------------------------

# Base path for API calls. "/api" uses the Vite dev proxy and, in
# production, the reverse proxy on the same origin.
VITE_API_BASE_URL="/api"

# Added in Stage 4 (Supabase Auth). The anon key is public by design,
# but still configured per environment rather than hard-coded.
# VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# VITE_SUPABASE_ANON_KEY=""
